# Public origin of the CoreD services website.
VITE_SITE_URL=https://coredhristi.com
# Public Turnstile site key for the contact form. Keep the verification secret server-side.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFshoNc7S7a7K5Gc
# Public Formspree form ID from its Integration page (the part after /f/).
VITE_FORMSPREE_FORM_ID=xgakkyab
# Formspree CAPTCHA settings must have Turnstile enabled with its matching secret.
# Formshield filtering and the form's honeypot provide additional spam protection.
VITE_CONTACT_SPAM_PROTECTION=turnstile
# Optional: URL of the CoreD backend that accepts unanswered assistant questions.
VITE_CHATBOT_API_URL=
