# CoreD static build — Hostinger Web/Cloud file hosting.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve page paths and query strings when visitors use the former domain.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?cored\.coredhristi\.com$ [NC]
  RewriteRule ^(.*)$ https://coredhristi.com/$1 [R=301,L]

  # Resolve legacy URLs on the server, before the app or real directories load.
  RewriteRule ^(?:seeOurWork|case-studies)/?$ /see-our-work [R=301,L]
  RewriteRule ^reach-us/?$ /contact [R=301,L]
  RewriteRule ^pricing-policy/?$ /pricingPolicy [R=301,L]

  RewriteCond %{QUERY_STRING} (^|&)service=(ai-powered-crm|ai-agents|ai-consulting|ai-cybersecurity|cybersecurity)(&|$)
  RewriteRule ^services/?$ /services/%2 [R=301,L,QSD]

  # Cloud partner pages are filled in from the CRM in the browser; serve the pre-rendered shell for any provider slug.
  RewriteCond %{DOCUMENT_ROOT}/cloud-partners/index.html -f
  RewriteRule ^cloud-partners/[^/]+/?$ /cloud-partners/index.html [L]

  # Keep real assets and generated HTML files directly accessible.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve each pre-rendered route at its clean URL, including on refresh.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# Unknown URLs use the real 404 response above, not a homepage with status 200.
# Configure HTTPS in hPanel after SSL is active; do not add proxy-blind redirects.
