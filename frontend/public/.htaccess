# CoreD static build — Hostinger Web/Cloud file hosting.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep real assets and generated HTML files directly accessible.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve each pre-rendered route at its clean URL, including on refresh.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# Unknown URLs use the real 404 response above, not a homepage with status 200.
# Configure HTTPS in hPanel after SSL is active; do not add proxy-blind redirects.
